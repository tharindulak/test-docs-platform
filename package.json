{
  "name": "@wso2/docs",
  "version": "0.1.0",
  "description": "WSO2 Docs Platform: builds every Docs deployment from Content repo releases.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "wso2-docs": "./bin/wso2-docs.mjs",
    "wso2-reports": "./bin/wso2-reports.mjs"
  },
  "files": [
    "bin/wso2-docs.mjs",
    "bin/wso2-reports.mjs",
    "lib/",
    "!lib/compose-command.mjs",
    "!lib/contrast.mjs",
    "!lib/crawl.mjs",
    "!lib/kv.mjs",
    "!lib/platform-release.mjs",
    "!lib/state-lock.mjs",
    "plugins/",
    "site/docusaurus.config.mjs",
    "site/sidebars.mjs",
    "site/package.json",
    "site/src/",
    "site/static/",
    "chrome/",
    "navigation/",
    "schemas/",
    "templates/",
    "standards/admonitions.yaml",
    "standards/checks.yaml",
    "standards/components.yaml",
    "standards/front-matter.yaml",
    "standards/iframe-hosts.yaml",
    "standards/page-types.yaml",
    "standards/skeleton.yaml",
    "standards/style-rules.yaml",
    "standards/terminology.yaml",
    "standards/dictionaries/",
    "standards/templates/",
    "standards/vale/",
    "search/docker-compose.yml",
    "worker/src/feedback-reasons.mjs",
    "worker/src/twin-paths.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "standards": "node scripts/build-standards.mjs",
    "test": "node --import ./test/setup.mjs --test --test-concurrency=1 test/*.test.mjs",
    "edge:local": "node worker/local.mjs",
    "edge:check": "wrangler deploy --dry-run -c worker/wrangler.jsonc --env staging --outdir .cache/edge-bundle",
    "convert": "node migration/convert.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/mdx-loader": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@fontsource-variable/inter": "5.2.8",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "^3.1.0",
    "@slorber/remark-comment": "1.0.0",
    "ajv": "8.20.0",
    "aws4fetch": "1.0.20",
    "clsx": "^2.1.1",
    "cspell-lib": "^10.4.0",
    "github-slugger": "1.5.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "node-html-parser": "^7.0.1",
    "parse5": "7.3.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-instantsearch": "7.50.1",
    "remark-directive": "3.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "semver": "^7.7.2",
    "typesense-instantsearch-adapter": "3.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@wso2/oxygen-ui": "0.16.0",
    "esbuild": "0.25.11",
    "miniflare": "5.20261001.0-alpha",
    "wrangler": "4.147.0"
  }
}
