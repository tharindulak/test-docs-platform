{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wso2.com/schemas/sdks.schema.json",
  "title": "SDK list data file",
  "description": "The SDKs a product offers, generated upstream and committed by bot PR; an SDK picker or catalog page renders it.",
  "type": "object",
  "required": ["schemaVersion", "sdks"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "sdks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "language", "repo"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 1 },
          "framework": { "type": "string", "minLength": 1 },
          "package": {
            "type": "object",
            "required": ["registry", "name"],
            "additionalProperties": false,
            "properties": {
              "registry": { "enum": ["npm", "maven", "pypi", "nuget", "go", "pub", "cocoapods", "cargo", "other"] },
              "name": { "type": "string", "minLength": 1 }
            }
          },
          "version": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "pattern": "^https?://" },
          "docs": { "type": "string", "pattern": "^(docs:|https?://|/|[a-z0-9][^:]*$)", "description": "The SDK's guide: a docs: link, a page path or a URL." },
          "status": { "enum": ["ga", "beta", "deprecated"] }
        }
      }
    }
  }
}
