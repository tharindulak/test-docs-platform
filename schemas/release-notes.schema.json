{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.wso2.com/schemas/release-notes.schema.json",
  "title": "Release notes data file",
  "description": "Release-note data generated by the product's CI and committed to the Content repo by bot PR; a Release notes page renders it.",
  "type": "object",
  "required": ["schemaVersion", "releases"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "releases": {
      "type": "array",
      "description": "Newest first.",
      "items": {
        "type": "object",
        "required": ["version", "date", "items"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+|cloud-[0-9]{4}\\.[0-9]{2}\\.[0-9]{2})$", "description": "An exact or date version, or cloud-<YYYY.MM.DD> for a Cloud update." },
          "date": { "$ref": "#/$defs/date" },
          "title": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "title"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["new", "improved", "fixed", "deprecated", "removed", "security"] },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "links": { "type": "array", "items": { "type": "string", "pattern": "^(docs:|https?://)" } },
                "issues": { "type": "array", "items": { "type": "string", "pattern": "^https?://" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
