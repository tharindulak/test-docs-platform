#!/bin/sh
# Before each commit: the fast tests (npm run test:fast, test/ without the
# builds, spec checks included). A failure stops the commit. Wired by
# `npm ci` (the prepare script sets core.hooksPath to .githooks); git resolves
# that path in each worktree's own checkout, so every worktree runs its own.
#
# git sets GIT_DIR, GIT_INDEX_FILE and others for hooks; unset them, or the
# tests' own throwaway git repos would write to this one.
for v in $(env | sed -n 's/^\(GIT_[A-Za-z0-9_]*\)=.*/\1/p'); do unset "$v"; done
cd "$(dirname "$0")/.." && mkdir -p .cache || exit 1
if ! npm run --silent test:fast >.cache/pre-commit.log 2>&1; then
  grep -E '^(not ok|# (fail|tests|pass))|^✖|^ℹ (tests|pass|fail)' .cache/pre-commit.log >&2
  echo "pre-commit: npm run test:fast failed (full output: .cache/pre-commit.log); the commit is stopped" >&2
  exit 1
fi
